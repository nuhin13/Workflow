# Garazo runtime configuration — EXAMPLE ONLY.
#
# Every value here is a safe local placeholder. No real endpoint, credential or
# production value belongs in this repository (task §4). Copy to `.env` for
# local Compose use; `.env` is gitignored.
#
# Key names are validated by packages/runtime-config. A missing or malformed
# key stops the process at startup rather than at first use.

# ── Common (all services) ────────────────────────────────────────────────────
APP_ENV=development                  # development | test | staging | production
LOG_LEVEL=info                       # debug | info | warn | error

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000
# Local development database from infra/compose/compose.development.yaml.
# Production supplies a MANAGED PostgreSQL URL from the host environment; it is
# never committed and never runs on the application VM (ADR-0005, ADR-0006).
DATABASE_URL=postgres://garazo:garazo-local-dev@postgres:5432/garazo
# Diagnostic probe from E00-T02. MUST be false outside development/test; the
# config layer refuses to boot a production process with it enabled.
WALKING_SKELETON_ENABLED=true

# ── Worker ───────────────────────────────────────────────────────────────────
# E00 runs a single consumer. This is a skeleton value, not a throughput
# commitment.
WORKER_CONCURRENCY=1

# ── Admin ────────────────────────────────────────────────────────────────────
API_BASE_URL=http://api:3000

# ── Provider boundaries (named, unused) ──────────────────────────────────────
# Declared so operators can see the shape of what is coming. Each is read only
# by its own adapter, in its own approved task (ADR-0004). No CREDENTIAL key
# exists yet, deliberately.
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# FIREBASE_PROJECT_ID=
# SMS_PROVIDER=
